# Copy to .env for local development. Do not commit real credentials.
APP_ENV=development
APP_DEBUG=true
APP_NAME=SPIP API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=1048576
DATABASE_URL=postgresql+psycopg://<database-user>:<database-password>@db:5432/<database-name>
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
SECRET_KEY=change_this_to_a_secure_32_character_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
SAP_ADAPTER_MODE=mock
VITE_API_BASE_URL=http://localhost:8000/api/v1
